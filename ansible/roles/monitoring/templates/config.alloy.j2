// СГЕНЕРИРОВАНО Ansible - правьте не этот файл, а mon_services в group_vars.
//
// Grafana Alloy - единственный коллектор.
//   1. Пробит все сервисы blackbox-ом  -> probe_success (красный / зелёный)
//   2. Скрейпит /metrics приложений    -> app_degraded  (жёлтый)
//   3. Снимает инфраструктуру родными экспортерами
//   4. Снимает место на диске
//   5. Пушит всё в Prometheus через remote_write
//
// Светофор считается не здесь, а recording-правилами Prometheus - там же,
// где живут алерты, чтобы цвет на дашборде и условие алерта не разъехались.

// -----------------------------------------------------------------------------
// 1. ИНВЕНТАРЬ СЕРВИСОВ И ПРОБЫ ДОСТУПНОСТИ
//
// Список статический, и это осознанно. Автообнаружение видит только
// ЗАПУЩЕННЫЕ контейнеры: если сервис упал, его цель исчезнет, probe_success
// перестанет писаться, и панель покажет "нет данных" вместо красного -
// ровно тогда, когда красный и нужен. Статический список это декларация
// "эти сервисы обязаны работать", и она даёт честный красный.
// -----------------------------------------------------------------------------
prometheus.exporter.blackbox "services" {
  config_file = "{{ mon_alloy_container_config_dir }}/blackbox.yml"
{% for s in mon_services if s.probe is defined %}

  target {
    name    = "{{ s.name }}"
    address = "{{ s.probe.address }}"
    module  = "{{ s.probe.module }}"
    labels  = { service = "{{ s.name }}", group = "{{ s.group }}", kind = "{{ s.kind | default('service') }}" }
  }
{% endfor %}
}

// Экспортер сам проставляет job=integrations/blackbox/<имя>, уникальный на
// каждую цель. Приводим к одному осмысленному job и делаем instance
// различимым: иначе пара job+instance совпадёт у всех целей и Prometheus
// отбросит их как дубли.
discovery.relabel "blackbox" {
  targets = prometheus.exporter.blackbox.services.targets

  rule {
    source_labels = ["service"]
    target_label  = "instance"
    action        = "replace"
  }

  rule {
    target_label = "job"
    replacement  = "{{ mon_prefix }}-blackbox"
    action       = "replace"
  }
}

prometheus.scrape "blackbox" {
  targets         = discovery.relabel.blackbox.output
  forward_to      = [prometheus.remote_write.prom.receiver]
  job_name        = "{{ mon_prefix }}-blackbox"
  scrape_interval = "{{ mon_probe_interval }}"
  scrape_timeout  = "10s"
}

{% set with_metrics = mon_services | selectattr('metrics', 'defined') | list %}
{% if with_metrics %}
// -----------------------------------------------------------------------------
// 2. СОБСТВЕННЫЕ МЕТРИКИ СЕРВИСОВ
//
// Цели тоже статические и берутся из того же списка. Автообнаружение по
// docker-меткам здесь не используется намеренно: оно требует, чтобы метки
// проставили на чужих контейнерах, а состав сервисов всё равно описан выше.
// -----------------------------------------------------------------------------
prometheus.scrape "app_metrics" {
  targets = [
{% for s in with_metrics %}
    {"__address__" = "{{ s.metrics.address }}", "__metrics_path__" = "{{ s.metrics.path | default('/metrics') }}", "service" = "{{ s.name }}", "group" = "{{ s.group }}"},
{% endfor %}
  ]

  forward_to      = [prometheus.remote_write.prom.receiver]
  job_name        = "{{ mon_prefix }}-apps"
  scrape_interval = "{{ mon_metrics_interval }}"
}
{% endif %}

// -----------------------------------------------------------------------------
// 3. РОДНЫЕ ЭКСПОРТЕРЫ ИНФРАСТРУКТУРЫ
//
// Пробы дают только "жив / не жив". Жёлтый цвет берётся отсюда: у ES это
// штатный статус кластера, у Redis - отвалившееся сохранение и упор в maxmemory.
// -----------------------------------------------------------------------------
{% for s in mon_services if s.exporter is defined %}
{% if s.exporter == 'redis' %}
prometheus.exporter.redis "{{ s.name | replace('-', '_') }}" {
  redis_addr         = "{{ s.exporter_address }}"
  connection_timeout = "5s"
}
{% elif s.exporter == 'elasticsearch' %}
prometheus.exporter.elasticsearch "{{ s.name | replace('-', '_') }}" {
  address = "{{ s.exporter_address }}"
  timeout = "10s"
  indices = true
}
{% endif %}

discovery.relabel "{{ s.name | replace('-', '_') }}" {
  targets = prometheus.exporter.{{ s.exporter }}.{{ s.name | replace('-', '_') }}.targets

  rule {
    target_label = "service"
    replacement  = "{{ s.name }}"
    action       = "replace"
  }

  rule {
    target_label = "group"
    replacement  = "{{ s.group }}"
    action       = "replace"
  }

  rule {
    target_label = "job"
    replacement  = "{{ mon_prefix }}-{{ s.exporter }}"
    action       = "replace"
  }
}

prometheus.scrape "{{ s.name | replace('-', '_') }}" {
  targets         = discovery.relabel.{{ s.name | replace('-', '_') }}.output
  forward_to      = [prometheus.remote_write.prom.receiver]
  job_name        = "{{ mon_prefix }}-{{ s.exporter }}"
  scrape_interval = "{{ mon_exporter_interval }}"
}

{% endfor %}
// -----------------------------------------------------------------------------
// 4. ХОСТ: МЕСТО НА ДИСКЕ
//
// Тот же node_exporter, только встроенный в Alloy - отдельный контейнер
// экспортера не нужен, всё собирает один агент.
// -----------------------------------------------------------------------------
prometheus.exporter.unix "host" {
  rootfs_path              = "/host/root"
  procfs_path              = "/host/proc"
  sysfs_path               = "/host/sys"
  include_exporter_metrics = false
  set_collectors           = ["filesystem", "diskstats", "meminfo", "loadavg", "cpu"]

  filesystem {
    mount_points_exclude = "{{ mon_fs_mount_points_exclude }}"
    fs_types_exclude     = "{{ mon_fs_types_exclude }}"
    mount_timeout        = "5s"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "{{ mon_prefix }}-host"
    action       = "replace"
  }
  rule {
    target_label = "instance"
    replacement  = "{{ mon_node_label }}"
    action       = "replace"
  }

}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.prom.receiver]
  job_name        = "{{ mon_prefix }}-host"
  scrape_interval = "{{ mon_exporter_interval }}"
}

// -----------------------------------------------------------------------------
// 5. САМОДИАГНОСТИКА АГЕНТА
//
// Если ослепнет сам Alloy, панели останутся зелёными по инерции последнего
// значения - поэтому за агентом следит отдельный алерт.
// -----------------------------------------------------------------------------
prometheus.exporter.self "alloy" {}

discovery.relabel "alloy_self" {
  targets = prometheus.exporter.self.alloy.targets

  rule {
    target_label = "job"
    replacement  = "{{ mon_prefix }}-alloy"
    action       = "replace"
  }
  rule {
    target_label = "instance"
    replacement  = "{{ mon_node_label }}"
    action       = "replace"
  }

}

prometheus.scrape "alloy" {
  targets         = discovery.relabel.alloy_self.output
  forward_to      = [prometheus.remote_write.prom.receiver]
  job_name        = "{{ mon_prefix }}-alloy"
  scrape_interval = "{{ mon_exporter_interval }}"
}

// -----------------------------------------------------------------------------
// 6. ОТПРАВКА В PROMETHEUS
// -----------------------------------------------------------------------------
prometheus.remote_write "prom" {
  external_labels = {
    node      = "{{ mon_node_label }}",
    collector = "alloy",
  }

  endpoint {
    url = "{{ mon_remote_write_url }}"

    queue_config {
      capacity   = 5000
      max_shards = 5
    }
  }
}

logging {
  level  = "info"
  format = "logfmt"
}
